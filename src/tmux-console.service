[Unit]
Description=Tmux persistent console sessions (creates console-1..10 on boot)
After=default.target

[Service]
Type=forking
ExecStart=/bin/bash %h/.tmux-persistent-console/setup.sh
ExecStop=/bin/bash -c 'for i in $(seq 1 10); do /usr/bin/tmux kill-session -t =console-$i 2>/dev/null; done; true'
RemainAfterExit=yes

# --- Hardening ---
# This service spawns interactive shells (console-1..10) where the user runs
# arbitrary commands: compilers, package managers, docker, AI coding agents.
# Directives below are chosen to reduce blast radius without blocking that
# use case. Do NOT add MemoryDenyWriteExecute, SystemCallFilter, or
# RestrictNamespaces here: they break interpreters/JITs and container
# tooling that users legitimately run inside their consoles.
NoNewPrivileges=true
RestrictSUIDSGID=true
# Mount-namespace-based sandboxing (ProtectSystem, ProtectControlGroups,
# ProtectKernelModules, PrivateTmp, ProtectHome) is intentionally NOT used:
# for USER-level units those directives need unprivileged user namespaces,
# which Ubuntu 23.10+ restricts via AppArmor by default — the service then
# fails to start at all (status=226/NAMESPACE; observed on GitHub's
# ubuntu-latest runners). A dead service means no sessions after reboot,
# which costs more than the marginal sandboxing of a process that already
# runs as the user. PrivateTmp would additionally hide tmux's /tmp/tmux-$UID
# socket from login shells and break `tmux attach` outright.

[Install]
WantedBy=default.target
